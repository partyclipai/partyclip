[Unit]
Description=Paperclip AI Agent Orchestrator
Requires=paperclip-db.service
After=paperclip-db.service

[Container]
Image=paperclip-local
ContainerName=paperclip
Pod=paperclip.pod
Volume=%h/.local/share/partyclip:/partyclip:Z
Environment=HOST=0.0.0.0
Environment=PARTYCLIP_HOME=/partyclip
Environment=PARTYCLIP_DEPLOYMENT_MODE=authenticated
Environment=PARTYCLIP_DEPLOYMENT_EXPOSURE=private
Environment=PARTYCLIP_PUBLIC_URL=http://localhost:3100
EnvironmentFile=%h/.config/containers/systemd/partyclip.env

[Service]
Restart=on-failure
TimeoutStartSec=120

[Install]
WantedBy=default.target
