{
  "name": "@partyclipai/plugin-news-ingest",
  "version": "0.1.0",
  "description": "First-party plugin: scheduled JSON Feed fetcher that emits structured news events (no raw text leakage to agents)",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "partyclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "scripts": {
    "prebuild": "pnpm --filter @partyclipai/plugin-sdk ensure-build-deps",
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "pnpm --filter @partyclipai/plugin-sdk ensure-build-deps && tsc --noEmit"
  },
  "dependencies": {
    "@partyclipai/plugin-sdk": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
